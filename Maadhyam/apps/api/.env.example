# Copy to apps/api/.env; never commit real keys.
MAADHYAM_GEMINI_API_KEY=
MAADHYAM_GEMINI_MODEL=gemini-2.5-flash
MAADHYAM_GEMINI_VERTEXAI=true
MAADHYAM_GOOGLE_CLOUD_PROJECT=maadhyam-1610
MAADHYAM_GOOGLE_CLOUD_LOCATION=global
MAADHYAM_FIRESTORE_DATABASE_ID=maadhyam
MAADHYAM_AI_TIMEOUT_MS=30000
MAADHYAM_PRODUCTION=false
# JSON syntax required for list-type pydantic-settings fields:
MAADHYAM_CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'
