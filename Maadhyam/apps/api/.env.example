# Copy to apps/api/.env; never commit real keys.
MAADHYAM_GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=maadhyam-1610
# Absolute path to your existing Firebase Admin service-account JSON:
GOOGLE_APPLICATION_CREDENTIALS=
MAADHYAM_SUPABASE_URL=
MAADHYAM_SUPABASE_SECRET_KEY=
MAADHYAM_SUPABASE_BUCKET=maadhyam-documents
# Optional local DNS-failure fallback; HTTPS certificate verification stays enabled.
MAADHYAM_SUPABASE_DNS_FALLBACK=false
MAADHYAM_GEMINI_MODEL=gemini-2.5-flash
# admin uses managed Google credentials; user-rest uses verified Firebase user tokens.
MAADHYAM_FIRESTORE_TRANSPORT=admin
MAADHYAM_ENVIRONMENT=development
# Optional production build directory when serving UI and API together.
MAADHYAM_WEB_DIST=
# JSON syntax required for list-type pydantic-settings fields:
MAADHYAM_CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'

# Cloud Run target: gcs. Keep supabase locally until the private GCS bucket exists.
MAADHYAM_FILE_STORAGE=supabase
MAADHYAM_GCS_BUCKET=
