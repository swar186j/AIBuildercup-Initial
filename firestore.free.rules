rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    match /users/{uid}/applications/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid) && request.resource.data.owner_user_id == uid
        && request.resource.data.id == id && request.resource.data.revision is int
        && request.resource.data.revision >= 1;
    }
    match /users/{uid}/vault/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid) && request.resource.data.id == id
        && request.resource.data.revision is int && request.resource.data.revision >= 1;
    }
    match /users/{uid}/settings/{id} {
      allow read, delete: if owner(uid) && id in ['household', 'planner'];
      allow create, update: if owner(uid) && id in ['household', 'planner']
        && request.resource.data.revision is int && request.resource.data.revision >= 1;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
